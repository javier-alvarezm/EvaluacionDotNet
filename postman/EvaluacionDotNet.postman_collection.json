        },
        {
          "name": "DELETE /rates/currency/{baseCurrency}: Elimina las tasas de cambio por moneda base.",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/rates/currency/{{baseCurrency}}",
            "description": "Elimina las tasas de cambio por moneda base."
