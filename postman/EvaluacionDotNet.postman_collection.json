{
  "info": {
    "name": "Evaluación .NET - Requerimientos del Proyecto",
    "description": "Solicita un JWT de dos horas y prueba los endpoints del documento. No requiere registro, login ni credenciales. La base debe tener las migraciones aplicadas, que incluyen USD y EUR. El CRUD usa EUR como moneda base; DELETE /rates/currency/EUR elimina todas sus tasas almacenadas. Ejecuta la colección sobre una base de pruebas. Las consultas e importaciones Frankfurter usan USD/EUR.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7131",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "baseCurrency",
      "value": "EUR",
      "type": "string"
    },
    {
      "key": "targetCurrency",
      "value": "USD",
      "type": "string"
    },
    {
      "key": "startDate",
      "value": "2020-01-02",
      "type": "string"
    },
    {
      "key": "endDate",
      "value": "2020-01-03",
      "type": "string"
    },
    {
      "key": "id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "JWT",
      "item": [
        {
          "name": "POST /auth/token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/token",
            "description": "POST /auth/token",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "pm.test('JWT válido por dos horas', () => pm.expect(pm.response.json().expiresIn).to.eql(7200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Endpoints CRUD",
      "item": [
        {
          "name": "POST /rates: Crea nuevas tasas de cambio.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/rates",
            "description": "Crea nuevas tasas de cambio.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseCurrency\": \"{{baseCurrency}}\",\n  \"targetCurrency\": \"{{targetCurrency}}\",\n  \"rate\": 2,\n  \"date\": \"{{startDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /rates: Crea nuevas tasas de cambio.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/rates",
            "description": "Crea nuevas tasas de cambio.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseCurrency\": \"{{baseCurrency}}\",\n  \"targetCurrency\": \"{{targetCurrency}}\",\n  \"rate\": 4,\n  \"date\": \"{{endDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /rates: Devuelve la lista de tasas de cambio almacenadas.",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rates",
            "description": "Devuelve la lista de tasas de cambio almacenadas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /rates/{id}: Devuelve una tasa de cambio específica por Id.",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rates/{{id}}",
            "description": "Devuelve una tasa de cambio específica por Id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /rates/currency/{baseCurrency}: Devuelve las tasas de cambio por moneda base.",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rates/currency/{{baseCurrency}}",
            "description": "Devuelve las tasas de cambio por moneda base."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Transformación de Datos",
      "item": [
        {
          "name": "GET /rates/average?base={baseCurrency}&target={targetCurrency}&start={startDate}&end={endDate}: Devuelve el valor promedio de la tasa de cambio entre las fechas especificadas.",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rates/average?base={{baseCurrency}}&target={{targetCurrency}}&start={{startDate}}&end={{endDate}}",
            "description": "Devuelve el valor promedio de la tasa de cambio entre las fechas especificadas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Promedio = 3', () => pm.expect(pm.response.json().average).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /rates/minmax?base={baseCurrency}&target={targetCurrency}&start={startDate}&end={endDate}: Devuelve los valores mínimo y máximo de la tasa de cambio entre las fechas especificadas.",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/rates/minmax?base={{baseCurrency}}&target={{targetCurrency}}&start={{startDate}}&end={{endDate}}",
            "description": "Devuelve los valores mínimo y máximo de la tasa de cambio entre las fechas especificadas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mínimo = 2, máximo = 4', () => { const d=pm.response.json(); pm.expect(d.min).to.eql(2); pm.expect(d.max).to.eql(4); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Endpoints CRUD - Actualizar y eliminar",
      "item": [
        {
          "name": "PUT /rates/{id}: Actualiza una tasa de cambio existente por Id.",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/rates/{{id}}",
            "description": "Actualiza una tasa de cambio existente por Id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseCurrency\": \"{{baseCurrency}}\",\n  \"targetCurrency\": \"{{targetCurrency}}\",\n  \"rate\": 3,\n  \"date\": \"{{startDate}}\"\n}",
              "options": {
