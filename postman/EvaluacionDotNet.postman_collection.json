            "description": "Actualiza las tasas de cambio por moneda base (requiere pasar un body con los datos a actualizar).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rate\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
